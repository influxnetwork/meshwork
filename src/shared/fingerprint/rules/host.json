{
  "version": "rules-3",
  "threshold": 0,
  "patterns": {
    "network": "cisco|juniper|aruba|ubiquiti|mikrotik|routerboard|netgear|tp-?link|d-?link|zyxel|huawei|arista|extreme networks|ruckus|meraki|cambium|draytek|edgecore|h3c|ruijie|tenda|asustek|linksys|eero|plume",
    "firewall": "fortinet|palo alto|sonicwall|watchguard|check point|sophos|barracuda|netgate",
    "wireless": "ruckus|aruba|cambium|ubiquiti|eero|plume",
    "printer": "hewlett[\\s-]*packard(?![\\s-]*enterprise)|hp inc|brother|epson|canon|lexmark|xerox|ricoh|kyocera|konica|sharp|\\boki\\b",
    "camera": "hikvision|dahua|axis comm|reolink|amcrest|uniview|hanwha|vivotek|mobotix|wyze",
    "storage": "synology|qnap|western digital|asustor|buffalo|netapp|terramaster",
    "iot": "espressif|tuya|shelly|allterco|raspberry|signify|philips lighting|ecobee|nest labs|ring llc|amazon technologies|sonoff|itead|xiaomi|wiz connected|lifx|meross",
    "media": "roku|sonos|vizio|tcl|hisense|lg electronics|samsung electronics|sony|bose|nvidia",
    "apple": "^apple",
    "voip": "polycom|\\bpoly\\b|yealink|grandstream|snom|avaya|mitel|fanvil|htek|alcatel-lucent enterprise"
  },
  "rules": [
    {
      "id": "vm",
      "when": {
        "virtualMac": true
      },
      "type": {
        "is": "vm",
        "confidence": 0.85,
        "why": "MAC belongs to a virtual machine network card"
      }
    },
    {
      "id": "onvif-camera",
      "when": {
        "match": {
          "field": "onvif",
          "pattern": "NetworkVideoTransmitter"
        }
      },
      "type": {
        "is": "camera",
        "confidence": 0.95,
        "why": "answers camera discovery (ONVIF)"
      }
    },
    {
      "id": "mdns-printer",
      "when": {
        "match": {
          "field": "services",
          "pattern": "^_pdl-datastream\\._tcp$"
        }
      },
      "type": {
        "is": "printer",
        "confidence": 0.95,
        "why": "announces a raw printing service"
      }
    },
    {
      "id": "mdns-print-service",
      "when": {
        "all": [
          {
            "match": {
              "field": "services",
              "pattern": "^_(ipp|ipps|printer)\\._tcp$"
            }
          },
          {
            "not": {
              "port": [
                22,
                135,
                139,
                445,
                548,
                3389,
                5900,
                62078
              ]
            }
          },
          {
            "not": {
              "vendor": "@apple"
            }
          }
        ]
      },
      "type": {
        "is": "printer",
        "confidence": 0.85,
        "why": "announces printing services and no computer services"
      }
    },
    {
      "id": "upnp-printer",
      "when": {
        "match": {
          "field": "upnp.deviceType",
          "pattern": ":device:Printer:"
        }
      },
      "type": {
        "is": "printer",
        "confidence": 0.9,
        "why": "describes itself as a printer (UPnP)"
      }
    },
    {
      "id": "upnp-storage",
      "when": {
        "all": [
          {
            "match": {
              "field": "upnp.manufacturer",
              "pattern": "^(Synology|QNAP|ASUSTOR|TerraMaster|Western Digital)\\b"
            }
          },
          {
            "not": {
              "match": {
                "field": "upnp.deviceType",
                "pattern": "InternetGatewayDevice|WLANAccessPoint|WFADevice"
              }
            }
          },
          {
            "gateway": false
          }
        ]
      },
      "type": {
        "is": "storage",
        "confidence": 0.9,
        "why": "describes itself as a storage device from its maker (UPnP)"
      }
    },
    {
      "id": "upnp-media",
      "when": {
        "all": [
          {
            "match": {
              "field": "upnp.deviceType",
              "pattern": ":device:MediaRenderer:"
            }
          },
          {
            "not": {
              "port": [
                22,
                135,
                139,
                445,
                548,
                3389,
                5900,
                62078
              ]
            }
          }
        ]
      },
      "type": {
        "is": "tv",
        "confidence": 0.8,
        "why": "describes itself as a media player (UPnP) and offers no computer services"
      }
    },
    {
      "id": "upnp-zone-player",
      "when": {
        "match": {
          "field": "upnp.deviceType",
          "pattern": ":device:ZonePlayer:"
        }
      },
      "type": {
        "is": "tv",
        "confidence": 0.85,
        "why": "describes itself as a networked speaker (UPnP)"
      }
    },
    {
      "id": "mdns-media",
      "when": {
        "match": {
          "field": "services",
          "pattern": "^_(googlecast|sonos|rdk-rics|amzn-wplay)\\._tcp$"
        }
      },
      "type": {
        "is": "tv",
        "confidence": 0.85,
        "why": "announces media casting services"
      }
    },
    {
      "id": "tls-signage",
      "when": {
        "match": {
          "field": "tls.subject",
          "pattern": "O=BrightSign\\b"
        }
      },
      "type": {
        "is": "tv",
        "confidence": 0.85,
        "why": "certificate of a digital signage player"
      }
    },
    {
      "id": "tls-server-management",
      "when": {
        "match": {
          "field": "tls.subject",
          "pattern": "idrac|Remote Access Group|Integrated Lights-Out|\\bIPMI\\b"
