      },
      "type": {
        "is": "firewall",
        "confidence": 0.85,
        "why": "firewall management page"
      },
      "os": {
        "is": "Network OS",
        "confidence": 0.7,
        "why": "its management page or greeting names network equipment software"
      }
    },
    {
      "id": "web-router",
      "when": {
        "match": {
          "field": "http.title",
          "pattern": "\\b(OpenWrt|LuCI|DD-WRT|EdgeOS)\\b"
