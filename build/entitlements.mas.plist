<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build: the app runs in the App Sandbox with only these permissions. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- Shared container for the app's own helper processes. -->
  <key>com.apple.security.application-groups</key>
  <array><string>__APPLE_TEAM_ID__.com.influxnetwork.meshwork</string></array>
  <!-- Scans, SNMP, DNS, port tests, traceroute. -->
  <key>com.apple.security.network.client</key><true/>
  <!-- DHCP server test (UDP 67/68) and discovery replies. -->
  <key>com.apple.security.network.server</key><true/>
  <!-- Nearby Wi-Fi network names; macOS shares them only with Location access. -->
  <key>com.apple.security.personal-information.location</key><true/>
  <!-- Lets the app read the neighbour table (device MAC addresses); granted through the provisioning profile. -->
  <key>com.apple.developer.networking.topology-observation</key><true/>
  <!-- Saving reports and exports, opening inventories the user picks. -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>
